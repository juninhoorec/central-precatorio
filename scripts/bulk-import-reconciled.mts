import fs from 'node:fs';
import readline from 'node:readline';
import { createClient } from '@libsql/client';
import { createDefaultWorkflow } from '../src/lib/operational-workflow.ts';
const db=createClient({url:'file:central-precatorios.db'}); const org='legacy-internal'; const source='CP · fila geral reconciliada · lote sem conflito'; const norm=(v:string)=>v.replace(/\D/g,'');
const conflicts=new Set<string>(); for await(const l of readline.createInterface({input:fs.createReadStream('data/reconciliation-staging/candidates-conflict-review.jsonl'),crlfDelay:Infinity})) if(l.trim()) conflicts.add(JSON.parse(l).depreKey);
const old=await db.execute({sql:'select json_extract(workflow,\'$.credit.numeroProcessoDEPRENormalizado\') k from operations where organization_id=?',args:[org]}); const existing=new Set(old.rows.map(r=>String(r.k||'')));
