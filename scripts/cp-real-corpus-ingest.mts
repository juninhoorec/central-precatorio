import {createClient} from "@libsql/client";import{createHash}from"node:crypto";import{readFile,writeFile}from"node:fs/promises";import path from"node:path";import*as pdfjs from"pdfjs-dist/legacy/build/pdf.mjs";import{parseTjspCacPage}from"../src/lib/tjsp-cac-report";import{initializeDocumentStorage}from"../src/lib/document-storage";import{initializeOperations,createOperation}from"../src/lib/operations";import{createDefaultWorkflow}from"../src/lib/operational-workflow";
const root=process.cwd(),dir=path.join(root,".local-data/real-cac"),org="legacy-internal",db=createClient({url:"file:"+path.join(dir,"pilot.db").replaceAll("\\","/")});await initializeOperations(db);await initializeDocumentStorage(db);
for(const sql of [`CREATE TABLE IF NOT EXISTS cac_ingestion_documents(document_id TEXT PRIMARY KEY,source TEXT,source_reference_date TEXT,collected_at TEXT,provenance_json TEXT)`,`CREATE TABLE IF NOT EXISTS cac_document_pages(document_id TEXT,page_number INTEGER,text TEXT,text_hash TEXT,structure_json TEXT,PRIMARY KEY(document_id,page_number))`,`CREATE TABLE IF NOT EXISTS cac_records(id TEXT PRIMARY KEY,document_id TEXT,page_number INTEGER,record_number INTEGER,fields_json TEXT,field_provenance_json TEXT)`])await db.execute(sql);
const op=(await db.execute({sql:"SELECT id FROM operations WHERE title=? AND organization_id=?",args:["CORPUS CONTROLADO — CAC/TJSP 04/09/2026",org]})).rows[0];let operationId=op?.id as string;if(!operationId)operationId=(await createOperation({title:"CORPUS CONTROLADO — CAC/TJSP 04/09/2026",debtor:"Múltiplos entes — corpus documental",tribunal:"TJSP/DEPRE",process:"CORPUS-CP-2.4.4A",owner:"Validação técnica local",source:"PDFs fornecidos pelo usuário",stage:"Entrada",nominal:0,notes:"Operação técnica de ingestão, não representa cliente ou processo individual.",tasks:[],checks:[],proposals:[],workflow:createDefaultWorkflow(0)},db,org,"cp-real-corpus-ingestion")).id;
const manifest=JSON.parse(await readFile(path.join(dir,"MANIFEST.json"),"utf8")),summary=[];for(const f of manifest.files){const bytes=new Uint8Array(await readFile(path.join(dir,f.filename))),hash=createHash("sha256").update(bytes).digest("hex");if(hash!==f.sha256)throw new Error("MANIFEST_SHA256_MISMATCH");let d=(await db.execute({sql:"SELECT id FROM operation_documents WHERE organization_id=? AND operation_id=? AND hash=?",args:[org,operationId,hash]})).rows[0],documentId=d?.id as string;if(!documentId){documentId=crypto.randomUUID();await db.execute({sql:"INSERT INTO operation_documents(id,operation_id,name,hash,content,created_at,organization_id,size,mime,status,scan_status,category,version,reviewer_notes,retention_until,created_by,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",args:[documentId,operationId,f.filename,hash,bytes,new Date().toISOString(),org,bytes.length,"application/pdf","QUARANTINED","NOT_SCANNED","PRECATORIO",1,"Corpus local controlado","","cp-real-corpus-ingestion",new Date().toISOString()]});}await db.execute({sql:"INSERT OR REPLACE INTO cac_ingestion_documents VALUES(?,?,?,?,?)",args:[documentId,"TJSP/DEPRE — usuário forneceu corpus", "2026-09-04",new Date().toISOString(),JSON.stringify({filename:f.filename,sha256:hash,organizationId:org,operationId,archive:"CP_REAL_CAC_PILOT_CORPUS.zip"})]});
const pdf=await pdfjs.getDocument({data:bytes,useSystemFonts:true,disableFontFace:true}).promise,old=await db.execute({sql:"SELECT count(*) n FROM cac_document_pages WHERE document_id=?",args:[documentId]});if(Number(old.rows[0].n)!==pdf.numPages){await db.execute({sql:"DELETE FROM cac_records WHERE document_id=?",args:[documentId]});await db.execute({sql:"DELETE FROM cac_document_pages WHERE document_id=?",args:[documentId]});for(let base=1;base<=pdf.numPages;base+=100){const batch:any[]=[];for(let pn=base;pn<=Math.min(pdf.numPages,base+99);pn++){const page=await pdf.getPage(pn),content=await page.getTextContent(),items=content.items.filter((x):x is typeof x&{str:string;transform:number[]}=>"str"in x).map(x=>({text:x.str,x:Math.round(x.transform[4]),y:Math.round(x.transform[5])})),text=items.map(x=>x.text).join(" "),records=parseTjspCacPage(items,pn,f.filename),ys=items.map(x=>x.y);batch.push({sql:"INSERT INTO cac_document_pages VALUES(?,?,?,?,?)",args:[documentId,pn,text,createHash("sha256").update(text).digest("hex"),JSON.stringify({itemCount:items.length,recordCount:records.length,records:records.map(r=>({record:r.record,topY:Math.max(...ys),bottomY:Math.min(...ys)}))})]});for(const r of records){const fields={numeroProcessoDEPRE:r.numeroProcessoDEPRE,numeroAutos:r.originProcessNumber,natureza:r.nature,esEP:r.epesNumber?(r.epesNumber+"/"+r.epesYear):"",ordemOrcamentaria:r.budgetOrder,valorAtualizado:r.amount,dataProtocolo:r.protocolDate,numeroProtocoloGeral:r.generalProtocol,autosAntigos:r.legacyProcess,advogados:[],devedora:"REPORT_HEADER"},id=`${documentId}:${pn}:${r.record}`,prov=Object.fromEntries(Object.keys(fields).map(k=>[k,k==="devedora"?{source:"REPORT_HEADER",page:1}:{source:"RECORD",page:pn,method:"DETERMINISTIC_LABEL_PARSE"}]));batch.push({sql:"INSERT INTO cac_records VALUES(?,?,?,?,?,?)",args:[id,documentId,pn,r.record,JSON.stringify(fields),JSON.stringify(prov)]});}}await db.batch(batch,"write");if(base%1000===1)console.log(JSON.stringify({document:f.filename,pageThrough:Math.min(pdf.numPages,base+99)}));}}
const counts=await db.execute({sql:"SELECT count(*) n FROM cac_records WHERE document_id=?",args:[documentId]});summary.push({documentId,filename:f.filename,sha256:hash,bytes:bytes.length,pages:pdf.numPages,records:Number(counts.rows[0].n),sourceReferenceDate:"2026-09-04",collectedAt:new Date().toISOString()});}
await writeFile(path.join(dir,"INGESTION_SUMMARY.json"),JSON.stringify({operationId,organizationId:org,documents:summary},null,2));console.log(JSON.stringify({operationId,documents:summary.map(x=>({id:x.documentId,name:x.filename,pages:x.pages,records:x.records})),totalRecords:summary.reduce((n,x)=>n+x.records,0)}));await db.close();
