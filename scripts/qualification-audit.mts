import { createClient } from "@libsql/client";
const c=createClient({url:process.env.DATABASE_URL||"file:central-precatorios.db"});const r=await c.execute("SELECT e.id,e.operation_id,e.document_type,e.status,e.evidence_strength,e.document_identifier,e.reference,e.source_url,e.published_at,json_extract(o.workflow,'$.credit.numeroProcessoDEPRE') depre FROM official_evidence_documents e JOIN operations o ON o.id=e.operation_id WHERE json_extract(o.workflow,'$.credit.numeroProcessoDEPRE') IN ('0038850-88.2017.8.26.0500','0165056-11.2021.8.26.0500') ORDER BY depre,e.collected_at");console.log(JSON.stringify(r.rows,null,2));
